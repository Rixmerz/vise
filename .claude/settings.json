{
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(.venv/bin/python -m coverage:*)",
      "Bash(.venv/bin/python -m ruff:*)",
      "Bash(.venv/bin/python -m bandit:*)",
      "Bash(.venv/bin/python -m vise:*)",
      "Bash(.venv/bin/vise:*)",
      "Bash(python3 -m venv:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Read(//home/user/vise/**)",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  },
  "env": {
    "VISE_TEST_CMD": ".venv/bin/python -m coverage run -m pytest -q",
    "VISE_LINT_CMD": ".venv/bin/python -m ruff check . --exclude .claude"
  }
}
