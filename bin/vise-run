#!/usr/bin/env bash
# vise launcher — prefers the dedicated venv created by install.sh, falls back
# to system python3, and refuses to launch an interpreter that cannot import
# vise's runtime deps. Used by .mcp.json and hooks/hooks.json so a single
# script decides which interpreter runs vise.
set -euo pipefail

# The plugin's options (`/plugin` → vise → Configure, or a row in `/config`)
# reach a hook process as CLAUDE_PLUGIN_OPTION_<KEY>, and the MCP server through
# the `env` block of .mcp.json. vise's code reads the VISE_* switches, so this
# is the one place an option becomes one. A VISE_* already in the environment
# wins: it is the more specific choice, made for this machine or this shell.
# Only exact values map. Anything else, including a placeholder an older
# Claude Code left unsubstituted, leaves the switch at its default.
_vise_truthy() {
  case "$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')" in
    true|1|yes|on) return 0 ;;
    *) return 1 ;;
  esac
}
_vise_falsy() {
  case "$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')" in
    false|0|no|off) return 0 ;;
    *) return 1 ;;
  esac
}
if [ -z "${VISE_GOAL_GATE+set}" ] && _vise_truthy "${CLAUDE_PLUGIN_OPTION_GOAL_GATE:-}"; then
  export VISE_GOAL_GATE=1
fi
if [ -z "${VISE_SNAPSHOT_ON_EDIT+set}" ] && _vise_truthy "${CLAUDE_PLUGIN_OPTION_SNAPSHOT_ON_EDIT:-}"; then
  export VISE_SNAPSHOT_ON_EDIT=1
fi
if [ -z "${VISE_WORKFLOW_SUGGEST+set}" ] && _vise_falsy "${CLAUDE_PLUGIN_OPTION_WORKFLOW_SUGGEST:-}"; then
  export VISE_WORKFLOW_SUGGEST=0
fi
if [ -z "${VISE_CODELAYER+set}" ]; then
  case "${CLAUDE_PLUGIN_OPTION_CODELAYER:-}" in
    off|warn|enforce) export VISE_CODELAYER="${CLAUDE_PLUGIN_OPTION_CODELAYER}" ;;
  esac
fi

# Same data-dir rule as vise.hooks._xdg: honor XDG_DATA_HOME only when it is
# set AND absolute, else ~/.local/share. Hardcoding the latter here is how the
# launcher and the rest of vise would drift apart on an XDG install.
if [ -n "${XDG_DATA_HOME:-}" ] && [ "${XDG_DATA_HOME#/}" != "${XDG_DATA_HOME}" ]; then
  DATA_DIR="${XDG_DATA_HOME}/vise"
else
  DATA_DIR="${HOME}/.local/share/vise"
fi

# The legacy location is tried second so an install made before this script
# became XDG-aware keeps running without a reinstall.
for candidate in "${DATA_DIR}/venv/bin/python" "${HOME}/.local/share/vise/venv/bin/python"; do
  if [ -x "$candidate" ]; then
    exec "$candidate" "$@"
  fi
done

# No venv anywhere. System python3 is a legitimate host, but only if it can
# actually import the runtime deps — `claude plugin install` copies the plugin
# files without provisioning anything, so this is the common case for a
# marketplace install. Exec'ing blindly here is what made that failure silent:
# the MCP server died on `import fastmcp` during startup and Claude Code simply
# listed no vise tools, with the traceback going nowhere the user would look.
if python3 -c "import fastmcp, fastembed" >/dev/null 2>&1; then
  exec python3 "$@"
fi

# Where this launcher lives IS the plugin root, whether that is a clone or the
# copy `claude plugin install` dropped in its cache. vise-mcp is not published
# on PyPI, so the deps-only path below has to install from here, not by name.
PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

cat >&2 <<EOF
vise: cannot start — no Python with vise's runtime deps (fastmcp, fastembed).

Installing the plugin copies its files but does not provision a Python
environment. To build one from a clone of the vise repo:

    git clone https://github.com/Rixmerz/vise && cd vise
    ./install.sh

install.sh also installs vise from that clone as vise@vise-dev. If you already
have vise@rixmerz, uninstall it first (see "Install" in the README) — loading
both duplicates every skill, command, agent, and this MCP server. To keep the
published install and only add the missing deps:

    python3 -m venv ${DATA_DIR}/venv
    ${DATA_DIR}/venv/bin/pip install ${PLUGIN_ROOT}

Then restart Claude Code.
EOF
exit 1
