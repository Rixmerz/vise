{
  "name": "vise",
  "description": "Phase-gated workflow enforcer, cross-project experience memory, and git snapshots for Claude Code",
  "version": "0.1.0a22",
  "mcpServers": "./.mcp.json",
  "lspServers": {
    "clangd": {
      "command": "clangd",
      "args": [
        "--background-index"
      ],
      "extensionToLanguage": {
        ".c": "c",
        ".h": "c",
        ".cpp": "cpp",
        ".cc": "cpp",
        ".cxx": "cpp",
        ".hpp": "cpp",
        ".hxx": "cpp"
      }
    },
    "csharp-ls": {
      "command": "csharp-ls",
      "extensionToLanguage": {
        ".cs": "csharp"
      }
    },
    "gopls": {
      "command": "gopls",
      "extensionToLanguage": {
        ".go": "go"
      }
    },
    "jdtls": {
      "command": "jdtls",
      "extensionToLanguage": {
        ".java": "java"
      }
    },
    "kotlin-lsp": {
      "command": "kotlin-lsp",
      "args": [
        "--stdio"
      ],
      "extensionToLanguage": {
        ".kt": "kotlin",
        ".kts": "kotlin"
      }
    },
    "lua": {
      "command": "lua-language-server",
      "extensionToLanguage": {
        ".lua": "lua"
      }
    },
    "intelephense": {
      "command": "intelephense",
      "args": [
        "--stdio"
      ],
      "extensionToLanguage": {
        ".php": "php"
      }
    },
    "pyright": {
      "command": "pyright-langserver",
      "args": [
        "--stdio"
      ],
      "extensionToLanguage": {
        ".py": "python",
        ".pyi": "python"
      }
    },
    "ruby-lsp": {
      "command": "ruby-lsp",
      "extensionToLanguage": {
        ".rb": "ruby",
        ".rake": "ruby",
        ".gemspec": "ruby",
        ".ru": "ruby",
        ".erb": "erb"
      }
    },
    "rust-analyzer": {
      "command": "rust-analyzer",
      "extensionToLanguage": {
        ".rs": "rust"
      }
    },
    "sourcekit-lsp": {
      "command": "sourcekit-lsp",
      "extensionToLanguage": {
        ".swift": "swift"
      }
    },
    "typescript": {
      "command": "typescript-language-server",
      "args": [
        "--stdio"
      ],
      "extensionToLanguage": {
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".js": "javascript",
        ".jsx": "javascriptreact",
        ".mts": "typescript",
        ".cts": "typescript",
        ".mjs": "javascript",
        ".cjs": "javascript"
      }
    }
  }
}
